{
  "name": "stepwise",
  "version": "1.0.0",
  "private": true,
  "description": "Socratic, 8-bit LeetCode practice feed with synced progress (Node + TypeScript + Postgres).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/index.js",
    "test": "tsc -p tsconfig.json && node --test test/"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
